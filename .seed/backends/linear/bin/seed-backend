#!/bin/sh
# linear backend plugin: the port over Linear's GraphQL API.
# Invoked by the engine as: seed-backend <verb> [id] [flags] --json
# State mapping (plan os-73814c53) is BY WORKFLOW STATE NAME against the
# documented convention: Backlog=backlog, Todo=ready, In Progress=in_progress,
# In Review=review, Blocked=blocked (required custom state), Done=done,
# Canceled=cancelled. A workflow missing a required state → exit 5 with
# remediation. Seed bookkeeping rides labels: seed:bo:<entry> (blocked_on),
# seed:author:<actor>, seed:rejected:<actor>, seed:tok:c-<hex> (the minted
# per-claim fence token: D1 binding, same posture as beads/paperclip: the
# API key alone cannot tell a reaped predecessor from the same actor's new
# claim; the rotating token can), seed:audit (the audit-sink issue, never a
# card). Ordering discipline (plan os-69bd5a64): the fallible state move
# always runs before bookkeeping is destroyed; a failed claim is compensated
# and then verified against the substrate (last-write-wins races resolve to
# the actual holder); per-dependent cascade failures skip-and-report instead
# of aborting the terminal verb. Envelopes and embedded ids are jq-built:
# caller values can never break the JSON.
set -u
for c in curl jq; do
  command -v "$c" >/dev/null 2>&1 || { printf '{"ok":false,"schema_version":"1.0","error":"backend_unavailable","message":"%s not installed"}\n' "$c"; exit 5; }
done
: "${LINEAR_API_KEY:?}" "${LINEAR_TEAM_ID:?}"
url="${LINEAR_API_URL:-https://api.linear.app/graphql}"

verb=${1:-}; [ $# -gt 0 ] && shift
id=""
case "${1:-}" in
  ""|-*) ;;
  *) id=$1; shift ;;
esac

title="" body="" priority="P2" actor="" token="" to="" resolution="" kind="" ref="" event="" pr="" blocked_on_arg="" blocked_by="" state_filter=""
while [ $# -gt 0 ]; do
  case "$1" in
    --title) title=$2; shift 2 ;;
    --body) body=$2; shift 2 ;;
    --priority) priority=$2; shift 2 ;;
    --actor) actor=$2; shift 2 ;;
    --token) token=$2; shift 2 ;;
    --to) to=$2; shift 2 ;;
    --resolution) resolution=$2; shift 2 ;;
    --kind) kind=$2; shift 2 ;;
    --ref) ref=$2; shift 2 ;;
    --event) event=$2; shift 2 ;;
    --pr) pr=$2; shift 2 ;;
    --state) state_filter=$2; shift 2 ;;
    --blocked-on) blocked_on_arg=$2; shift 2 ;;
    --blocked-by) blocked_by="$blocked_by $2"; shift 2 ;;
    --lease) shift 2 ;;
    --json|--no-pr) shift ;;
    --*) [ $# -ge 2 ] && case "$2" in -*) shift ;; *) shift 2 ;; esac || shift ;;
    *) shift ;;
  esac
done

# Envelopes are built with jq: caller-controlled values (actors, ids,
# messages) must never be interpolated into JSON by hand.
fail() {
  jq -nc --arg v "$verb" --arg e "$2" --arg m "${3:-}" \
    '{ok:false, schema_version:"1.0", verb:$v, error:$e, message:$m}'
  exit "$1"
}
# The port contract's contention shape: cause claim_contention plus a
# top-level holder field an orchestrator can act on.
fail_contention() { # HOLDER [MESSAGE]
  jq -nc --arg v "$verb" --arg h "$1" --arg m "${2:-held by $1}" \
    '{ok:false, schema_version:"1.0", verb:$v, error:"claim_contention", holder:$h, message:$m}'
  exit 2
}
envelope() { printf '{"ok":true,"schema_version":"1.0","verb":"%s"%s}\n' "$verb" "${1:-}"; }
jstr() { jq -nc --arg s "$1" '$s'; } # JSON-encode one string

# gql OPNAME QUERY VARIABLES_JSON: one GraphQL call; .errors → caller sees
# empty data. The response body is printed; rc-style checks read .errors.
SEED_LN_ERR=$(mktemp)
trap 'rm -f "$SEED_LN_ERR"' EXIT
gql() {
  req=$(jq -nc --arg q "$2" --argjson v "${3:-{\}}" '{query:$q, variables:$v}')
  out=$(curl -sS -X POST -H "Authorization: $LINEAR_API_KEY" -H "Content-Type: application/json" \
    -d "$req" "$url" 2>/dev/null) || { echo network >"$SEED_LN_ERR"; return 1; }
  printf '%s' "$out" | jq -r '(.errors // []) | map(.message) | join("; ")' >"$SEED_LN_ERR"
  printf '%s' "$out"
}
gqlerr() { cat "$SEED_LN_ERR"; }

# --- state mapping (by name; refuse with remediation when missing) --------
ln_name() { # port state → Linear workflow state name
  case "$1" in backlog) echo "Backlog";; ready) echo "Todo";; in_progress) echo "In Progress";;
    review) echo "In Review";; blocked) echo "Blocked";; done) echo "Done";; cancelled) echo "Canceled";; *) echo "";; esac
}
STATES_JSON=""
# load_states sets $STATES_JSON and fail()s in the PARENT shell on a query
# failure: a dead API must surface as backend_unavailable, never as a
# missing-workflow-state remediation.
load_states() {
  [ -n "$STATES_JSON" ] && return
  STATES_JSON=$(gql WorkflowStates 'query WorkflowStates($teamId: String!) { team(id: $teamId) { states { nodes { id name } } } }' \
    "{\"teamId\":\"$LINEAR_TEAM_ID\"}" | jq -c '.data.team.states.nodes // []')
  [ -z "$(gqlerr)" ] || fail 5 backend_unavailable "workflow states query: $(gqlerr)"
  [ "$STATES_JSON" != "[]" ] && [ -n "$STATES_JSON" ] || fail 5 backend_unavailable "workflow states query returned nothing (check LINEAR_TEAM_ID)"
}
# state_id sets $SID and fail()s in the PARENT shell, never call it inside
# a command substitution: the exit-5 remediation must terminate the verb,
# not get embedded into a JSON payload as text.
state_id() {
  name=$(ln_name "$1")
  load_states
  SID=$(printf '%s' "$STATES_JSON" | jq -r --arg n "$name" '.[] | select(.name == $n) | .id')
  [ -n "$SID" ] || fail 5 backend_unavailable "team workflow has no '$name' state — add it once in Linear team settings (required convention, see .seed/backends/linear/README.md)"
}
port_state() { # Linear state name → port state
  case "$1" in Backlog) echo backlog;; Todo) echo ready;; "In Progress") echo in_progress;;
    "In Review") echo review;; Blocked) echo blocked;; Done) echo done;; Canceled) echo cancelled;; *) echo unknown;; esac
}
prio_ln() { case "$1" in P0) echo 1;; P1) echo 2;; P2) echo 3;; P3) echo 4;; *) echo 3;; esac; }
LJQ='def pport: {"1":"P0","2":"P1","3":"P2","4":"P3"}[(.|tostring)] // "P2";
     def prank: {"P0":0,"P1":1,"P2":2,"P3":3}[.] // 2;
     def pstate: {"Backlog":"backlog","Todo":"ready","In Progress":"in_progress","In Review":"review","Blocked":"blocked","Done":"done","Canceled":"cancelled"}[.] // "unknown";'

get_issue() {
  gql Issue 'query Issue($id: String!) { issue(id: $id) { id identifier title description priority createdAt state { id name } assignee { id name } labels { nodes { id name } } } }' \
    "{\"id\":\"$1\"}" | jq -c '.data.issue'
}
# require_issue/require_fence set $CUR and fail() in the PARENT shell,
# never call them inside a command substitution (a subshell exit cannot
# propagate the port exit code).
require_issue() {
  CUR=$(get_issue "$1")
  err=$(gqlerr)
  if [ -n "$err" ]; then
    # Linear reports unknown ids as errors; anything else is the backend.
    case "$err" in
      *[Nn]"ot found"*|*"Entity not found"*) fail 4 not_found "no issue $1" ;;
      *) fail 5 backend_unavailable "issue query: $err" ;;
    esac
  fi
  [ "$CUR" != "null" ] && [ -n "$CUR" ] || fail 4 not_found "no issue $1"
}
istate() { printf '%s' "$1" | jq -r '.state.name'; }
iassignee() { printf '%s' "$1" | jq -r '.assignee.id // ""'; }
ilabels() { printf '%s' "$1" | jq -r '.labels.nodes[].name'; }

label_id() { # find-or-create a team label by name → id
  lid=$(gql TeamLabels 'query TeamLabels($teamId: String!) { team(id: $teamId) { labels { nodes { id name } } } }' \
    "{\"teamId\":\"$LINEAR_TEAM_ID\"}" | jq -r --arg n "$1" '.data.team.labels.nodes[] | select(.name == $n) | .id')
  [ -n "$lid" ] && { echo "$lid"; return; }
  gql LabelCreate 'mutation LabelCreate($input: IssueLabelCreateInput!) { issueLabelCreate(input: $input) { success issueLabel { id name } } }' \
    "$(jq -nc --arg n "$1" --arg t "$LINEAR_TEAM_ID" '{input:{name:$n, teamId:$t}}')" | jq -r '.data.issueLabelCreate.issueLabel.id'
}

# try_update ID INPUT_JSON: the non-fatal issueUpdate core: sets TU_RC
# (0 ok / 5 substrate refusal or outage) and TU_MSG; never exits, so
# callers with something to compensate or skip can do so before
# propagating. update_issue is the fatal wrapper for callers with nothing
# to unwind.
try_update() {
  gql IssueUpdate 'mutation IssueUpdate($id: String!, $input: IssueUpdateInput!) { issueUpdate(id: $id, input: $input) { success issue { id } } }' \
    "$(jq -nc --arg id "$1" --argjson i "$2" '{id:$id, input:$i}')" >/dev/null
  if [ -n "$(gqlerr)" ]; then TU_RC=5; TU_MSG="issueUpdate: $(gqlerr)"; else TU_RC=0; TU_MSG=""; fi
}
update_issue() {
  try_update "$@"
  [ "$TU_RC" = "0" ] || fail 5 backend_unavailable "$TU_MSG"
}

# relabel IID CUR add=NAMES del=SELECTOR: a selector ending in ":" deletes
# the whole namespace (seed:tok:, seed:author:); anything else deletes ONLY
# the exact label name, so removing seed:bo:dep:LIN-1 can never strip
# seed:bo:dep:LIN-10. Declared variance: Linear's issueUpdate replaces the
# whole labelIds array (no atomic add/remove operations like Jira's), so
# the set is recomputed from the snapshot immediately before the write:
# the remaining race window is declared in the README. try_relabel is the
# non-fatal core (sets RL_RC/RL_MSG) for callers that must compensate or
# skip-and-report; relabel is the fatal wrapper.
try_relabel() {
  iid=$1; cur=$2; adds=$3; delsel=$4
  keep=$(printf '%s' "$cur" | jq -c --arg d "$delsel" '[.labels.nodes[]
    | select(if $d == "" then true
             elif ($d | endswith(":")) then ((.name | startswith($d)) | not)
             else (.name != $d) end)
    | .id]')
  for n in $adds; do
    lid=$(label_id "$n")
    keep=$(printf '%s' "$keep" | jq -c --arg l "$lid" '. + [$l] | unique')
  done
  try_update "$iid" "{\"labelIds\": $keep}"
  RL_RC=$TU_RC; RL_MSG=$TU_MSG
}
relabel() {
  try_relabel "$@"
  [ "$RL_RC" = "0" ] || fail 5 backend_unavailable "$RL_MSG"
}

# The fence: assignee-match AND the minted seed:tok:<token> label. Both
# rotate on every claim; stale tokens (a reaped predecessor, even the same
# actor) exit 6. Actors are Linear user ids, so the assignee comparison is
# by .assignee.id.
require_fence() {
  require_issue "$1"
  holder=$(iassignee "$CUR")
  [ -n "$token" ] || fail 6 fenced_out "no claim token presented"
  printf '%s\n' "$(ilabels "$CUR")" | grep -qxF "seed:tok:$token" || fail 6 fenced_out "token does not match the live claim"
  [ "$actor" = "$holder" ] || fail 6 fenced_out "actor is not the assignee of record"
}

mint() { hexdump -n8 -e '8/1 "%02x"' /dev/urandom 2>/dev/null || od -N8 -An -tx1 /dev/urandom | tr -d ' \n'; }

bo_entries() { printf '%s\n' "$(ilabels "$1")" | sed -n 's/^seed:bo://p'; }
bo_json() { bo_entries "$1" | jq -R . | jq -cs .; }

comment_on() { # ID BODY: sets $CID to the created comment id
  out=$(gql CommentCreate 'mutation CommentCreate($input: CommentCreateInput!) { commentCreate(input: $input) { success comment { id } } }' \
    "$(jq -nc --arg i "$1" --arg b "$2" '{input:{issueId:$i, body:$b}}')")
  [ -z "$(gqlerr)" ] || fail 5 backend_unavailable "commentCreate: $(gqlerr)"
  CID=$(printf '%s' "$out" | jq -r '.data.commentCreate.comment.id // ""')
}

# load_issues sets $ISSUES_JSON (every page of the team issue connection)
# and fail()s in the PARENT shell on a GraphQL error: an expired key or
# rate limit must exit 5, never masquerade as an empty queue or a cascade
# with no dependents.
load_issues() {
  ISSUES_JSON="[]"
  cursor=""
  while :; do
    vars=$(jq -nc --arg t "$LINEAR_TEAM_ID" --arg c "$cursor" '{teamId:$t} + (if $c != "" then {after:$c} else {} end)')
    page=$(gql Issues 'query Issues($teamId: String!, $after: String) { team(id: $teamId) { issues(first: 100, after: $after) { pageInfo { hasNextPage endCursor } nodes { id identifier title description priority createdAt state { id name } assignee { id name } labels { nodes { id name } } } } } }' "$vars")
    [ -z "$(gqlerr)" ] || fail 5 backend_unavailable "issues query: $(gqlerr)"
    nodes=$(printf '%s' "$page" | jq -c '.data.team.issues.nodes // []')
    ISSUES_JSON=$(jq -nc --argjson a "$ISSUES_JSON" --argjson b "$nodes" '$a + $b')
    more=$(printf '%s' "$page" | jq -r '.data.team.issues.pageInfo.hasNextPage // false')
    [ "$more" = "true" ] || break
    cursor=$(printf '%s' "$page" | jq -r '.data.team.issues.pageInfo.endCursor // ""')
    [ -n "$cursor" ] || break
  done
}

# cascade FROM_ID: remove dep:<id> everywhere (close AND cancel edges carry
# the effect, per the transition table); issues left blocked on nothing go
# back to Todo. Per-dependent failures: the release move OR the label
# bookkeeping: do NOT abort the terminal verb or the rest of the cascade:
# the dependent is reported in $cascade_skipped with its dependency entry
# preserved (a failed post-release label write rolls the state back to
# Blocked so the entry stays recoverable), and recovery is an operator
# unblock once the substrate allows the moves. The fallible state move runs
# BEFORE the label is destroyed. Sets $cascaded and $cascade_skipped.
cascade() {
  cascaded="[]"; cascade_skipped="[]"
  state_id ready; todo_id=$SID
  load_issues
  for dep in $(printf '%s' "$ISSUES_JSON" | jq -r --arg l "seed:bo:dep:$1" '.[] | select([.labels.nodes[].name] | index($l)) | .id'); do
    require_issue "$dep"; cur=$CUR
    left=$(bo_entries "$cur" | grep -vxF "dep:$1" | head -1)
    if [ "$(istate "$cur")" = "Blocked" ] && [ -z "$left" ]; then
      try_update "$dep" "{\"stateId\": \"$todo_id\"}"
      if [ "$TU_RC" = "0" ]; then
        require_issue "$dep"; cur=$CUR
        try_relabel "$dep" "$cur" "" "seed:bo:dep:$1"
        if [ "$RL_RC" = "0" ]; then
          cascaded=$(printf '%s' "$cascaded" | jq -c --arg d "$dep" '. + [$d]')
        else
          # The release landed but the entry could not be cleared: roll
          # the state back so Blocked + recorded entry stays the truth,
          # never a Todo issue hidden from ready by a stale seed:bo label.
          bid=$(printf '%s' "$STATES_JSON" | jq -r '.[] | select(.name == "Blocked") | .id')
          [ -n "$bid" ] && try_update "$dep" "{\"stateId\": \"$bid\"}"
          cascade_skipped=$(printf '%s' "$cascade_skipped" | jq -c --arg d "$dep" '. + [$d]')
        fi
      else
        cascade_skipped=$(printf '%s' "$cascade_skipped" | jq -c --arg d "$dep" '. + [$d]')
      fi
    else
      try_relabel "$dep" "$cur" "" "seed:bo:dep:$1"
      [ "$RL_RC" = "0" ] || cascade_skipped=$(printf '%s' "$cascade_skipped" | jq -c --arg d "$dep" '. + [$d]')
    fi
  done
}

release_claim() { # ID CUR: clear assignee + token label
  relabel "$1" "$2" "" "seed:tok:"
  update_issue "$1" '{"assigneeId": null}'
}

case "$verb" in
  create)
    state_id backlog; sid=$SID
    out=$(gql IssueCreate 'mutation IssueCreate($input: IssueCreateInput!) { issueCreate(input: $input) { success issue { id identifier } } }' \
      "$(jq -nc --arg t "$title" --arg d "$body" --arg s "$sid" --arg team "$LINEAR_TEAM_ID" \
        --argjson p "$(prio_ln "$priority")" '{input:{title:$t, description:$d, stateId:$s, teamId:$team, priority:$p}}')")
    [ -z "$(gqlerr)" ] || fail 5 backend_unavailable "issueCreate: $(gqlerr)"
    nid=$(printf '%s' "$out" | jq -r '.data.issueCreate.issue.id')
    for d in $blocked_by; do
      require_issue "$nid"; cur=$CUR
      relabel "$nid" "$cur" "seed:bo:dep:$d" ""
    done
    envelope ",\"task\":$(jstr "$nid"),\"state\":\"backlog\""
    ;;

  ready)
    load_issues
    tasks=$(printf '%s' "$ISSUES_JSON" | jq -c --arg a "$actor" "$LJQ"'[ .[]
      | select(.state.name == "Todo")
      | select((.assignee.id // "") == "")
      | select(([.labels.nodes[].name] | map(select(. == ("seed:rejected:" + $a))) | length) == 0)
      | select(([.labels.nodes[].name] | map(select(startswith("seed:bo:"))) | length) == 0)
      | select(([.labels.nodes[].name] | index("seed:audit")) | not)
      | {task: .id, title: .title, priority: (.priority | pport), created_at: .createdAt}]
      | sort_by((.priority | prank), .created_at)')
    envelope ",\"tasks\":$tasks"
    ;;

  get)
    require_issue "$id"; cur=$CUR
    pstate=$(port_state "$(istate "$cur")")
    [ "$pstate" != "unknown" ] || fail 5 backend_unavailable "issue $id is in workflow state '$(istate "$cur")', which is outside the seed state convention — map or move it (see .seed/backends/linear/README.md)"
    card=$(printf '%s' "$cur" | jq -c --arg s "$pstate" --arg bo "$(bo_json "$cur")" "$LJQ"'{
      task: .id, title: .title, body: (.description // ""),
      priority: (.priority | pport),
      state: $s, holder: (.assignee.id // ""),
      blocked_on: ($bo | fromjson),
      rejected_authors: [.labels.nodes[].name | select(startswith("seed:rejected:")) | ltrimstr("seed:rejected:")]}')
    envelope ",\"task\":$(jstr "$id"),\"state\":\"$pstate\",\"card\":$card"
    ;;

  list)
    # Issues in workflow states outside the convention are not seed cards;
    # list skips them rather than emitting an invalid port state (declared).
    load_issues
    tasks=$(printf '%s' "$ISSUES_JSON" | jq -c --arg f "$state_filter" "$LJQ"'[ .[]
      | {task: .id, title: .title, state: (.state.name | pstate), priority: (.priority | pport)}
      | select(.state != "unknown")
      | select(($f == "") or (.state == $f))]')
    envelope ",\"tasks\":$tasks"
    ;;

  claim)
    require_issue "$id"; cur=$CUR
    printf '%s\n' "$(ilabels "$cur")" | grep -qxF "seed:audit" \
      && fail 3 invalid_transition "the seed:audit issue is the audit substrate, not a card"
    printf '%s\n' "$(ilabels "$cur")" | grep -qxF "seed:rejected:$actor" \
      && fail 2 rejected_author "$actor was the rejected implementer on this card"
    holder=$(iassignee "$cur")
    [ -n "$holder" ] && fail_contention "$holder"
    [ "$(istate "$cur")" = "Todo" ] || fail 3 invalid_transition "claim requires ready (Todo); issue is '$(istate "$cur")'"
    tok="c-$(mint)"
    state_id in_progress; prog_id=$SID
    # Declared variance: read-check then two GraphQL writes, last-write-wins
    #, no server arbitration (weaker than filecards push-wins). Post-claim
    # verification keeps an interleaved race from stranding the card, and a
    # failed assign+move is COMPENSATED so a failed claim leaves the issue
    # unchanged.
    relabel "$id" "$cur" "seed:tok:$tok" "seed:tok:"
    try_update "$id" "$(jq -nc --arg a "$actor" --arg s "$prog_id" '{assigneeId:$a, stateId:$s}')"
    if [ "$TU_RC" != "0" ]; then
      require_issue "$id"; cur=$CUR
      h=$(iassignee "$cur")
      if { [ -z "$h" ] || [ "$h" = "$actor" ]; } && printf '%s\n' "$(ilabels "$cur")" | grep -qxF "seed:tok:$tok"; then
        relabel "$id" "$cur" "" "seed:tok:$tok"
        [ "$h" = "$actor" ] && update_issue "$id" '{"assigneeId": null}'
      fi
      fail 5 backend_unavailable "claim rolled back: $TU_MSG"
    fi
    # Final verification: we won only if the substrate holds OUR assignee
    # AND OUR token. A coherent rival tuple (their assignee AND their
    # token) means they are the usable winner: contention with the real
    # holder. Anything else is a TORN interleave (assignee and token from
    # different claimants): no one holds a usable claim, so report
    # contention with the torn state named: an operator release/reap
    # recovers, and the next claim rotates both fields (declared, README).
    require_issue "$id"; cur=$CUR
    vh=$(iassignee "$cur")
    vtok=$(printf '%s\n' "$(ilabels "$cur")" | sed -n 's/^seed:tok://p' | head -1)
    if [ "$vh" != "$actor" ] || [ "$vtok" != "$tok" ]; then
      if [ -n "$vh" ] && [ "$vh" != "$actor" ] && [ -n "$vtok" ] && [ "$vtok" != "$tok" ]; then
        fail_contention "$vh"
      fi
      fail_contention "$vh" "torn claim interleave (assignee '$vh', token label '$vtok'): no usable claimant — operator release/reap recovers"
    fi
    envelope ",\"task\":$(jstr "$id"),\"state\":\"in_progress\",\"claim_token\":\"$tok\""
    ;;

  release)
    require_fence "$id"; cur=$CUR
    [ "$(istate "$cur")" = "In Progress" ] || fail 3 invalid_transition "release requires in_progress"
    state_id ready; update_issue "$id" "{\"stateId\": \"$SID\"}"
    require_issue "$id"; cur=$CUR
    release_claim "$id" "$cur"
    envelope ",\"task\":$(jstr "$id"),\"state\":\"ready\""
    ;;

  transition)
    case "$to" in
      review)
        require_fence "$id"; cur=$CUR
        [ "$(istate "$cur")" = "In Progress" ] || fail 3 invalid_transition "review requires in_progress"
        # The fallible state move runs FIRST: a refusal must leave the
        # claim intact so the worker can retry or park. A failed
        # author-label write after the move is COMPENSATED (state rolled
        # back to In Progress): review must never be reached without the
        # seed:author record the reject lockout depends on.
        state_id in_progress; prog_id=$SID
        state_id review; update_issue "$id" "{\"stateId\": \"$SID\"}"
        require_issue "$id"; cur=$CUR
        try_relabel "$id" "$cur" "seed:author:$actor" "seed:author:"
        if [ "$RL_RC" != "0" ]; then
          try_update "$id" "{\"stateId\": \"$prog_id\"}"
          fail 5 backend_unavailable "review transition rolled back (author record could not be written; claim intact — retry): $RL_MSG"
        fi
        require_issue "$id"; cur=$CUR
        release_claim "$id" "$cur"
        [ -n "$resolution" ] && comment_on "$id" "seed:evidence: $resolution"
        envelope ",\"task\":$(jstr "$id"),\"state\":\"review\",\"transitioned\":true"
        ;;
      blocked)
        require_fence "$id"; cur=$CUR
        [ "$(istate "$cur")" = "In Progress" ] || fail 3 invalid_transition "parking requires in_progress"
        [ -n "$blocked_on_arg" ] || fail 3 invalid_transition "blocked requires --blocked-on"
        # Same compensation as review: a Blocked issue must never exist
        # without its blocked_on entry on record.
        state_id in_progress; prog_id=$SID
        state_id blocked; update_issue "$id" "{\"stateId\": \"$SID\"}"
        require_issue "$id"; cur=$CUR
        try_relabel "$id" "$cur" "seed:bo:$blocked_on_arg" ""
        if [ "$RL_RC" != "0" ]; then
          try_update "$id" "{\"stateId\": \"$prog_id\"}"
          fail 5 backend_unavailable "park rolled back (blocked_on entry could not be written; claim intact — retry): $RL_MSG"
        fi
        require_issue "$id"; cur=$CUR
        release_claim "$id" "$cur"
        envelope ",\"task\":$(jstr "$id"),\"state\":\"blocked\",\"transitioned\":true"
        ;;
      ready)
        require_fence "$id"; cur=$CUR
        [ "$(istate "$cur")" = "In Progress" ] || fail 3 invalid_transition "release-shaped transition requires in_progress"
        state_id ready; update_issue "$id" "{\"stateId\": \"$SID\"}"
        require_issue "$id"; cur=$CUR
        release_claim "$id" "$cur"
        envelope ",\"task\":$(jstr "$id"),\"state\":\"ready\",\"transitioned\":true"
        ;;
      *) fail 3 invalid_transition "worker transition to '$to' is not a port edge" ;;
    esac
    ;;

  promote)
    require_issue "$id"; cur=$CUR
    [ "$(istate "$cur")" = "Backlog" ] || fail 3 invalid_transition "promote requires backlog"
    state_id ready; update_issue "$id" "{\"stateId\": \"$SID\"}"
    envelope ",\"task\":$(jstr "$id"),\"state\":\"ready\""
    ;;
  deprioritize)
    require_issue "$id"; cur=$CUR
    [ "$(istate "$cur")" = "Todo" ] || fail 3 invalid_transition "deprioritize requires ready"
    state_id backlog; update_issue "$id" "{\"stateId\": \"$SID\"}"
    envelope ",\"task\":$(jstr "$id"),\"state\":\"backlog\""
    ;;

  block)
    require_issue "$id"; cur=$CUR
    [ -n "$blocked_on_arg" ] || fail 3 invalid_transition "block requires --blocked-on"
    case "$(istate "$cur")" in Backlog|Todo|Blocked) ;; *) fail 3 invalid_transition "operator block from '$(istate "$cur")'";; esac
    # State move first: a refusal (or missing Blocked state) must not leave
    # a seed:bo label hiding a Todo issue from ready. A label failure after
    # the move is recovered by re-running block (an already-Blocked issue
    # accepts more entries).
    if [ "$(istate "$cur")" != "Blocked" ]; then
      state_id blocked; update_issue "$id" "{\"stateId\": \"$SID\"}"
    fi
    require_issue "$id"; cur=$CUR
    relabel "$id" "$cur" "seed:bo:$blocked_on_arg" ""
    envelope ",\"task\":$(jstr "$id"),\"state\":\"blocked\""
    ;;

  unblock|plan-unblock)
    require_issue "$id"; cur=$CUR
    [ "$(istate "$cur")" = "Blocked" ] || fail 3 invalid_transition "not blocked"
    if [ "$verb" = "plan-unblock" ]; then
      entry="plan:$pr"
    else
      # A bare operator unblock removes that operator's manual: entry.
      entry="${blocked_on_arg:-manual:$actor}"
    fi
    bo_entries "$cur" | grep -qxF "$entry" || fail 3 invalid_transition "no blocked_on entry '$entry'"
    left=$(bo_entries "$cur" | grep -vxF "$entry" | head -1)
    if [ -z "$left" ]; then
      # State move first: a refusal keeps the entry recorded for retry.
      state_id ready
      try_update "$id" "{\"stateId\": \"$SID\"}"
      [ "$TU_RC" = "0" ] || fail 5 backend_unavailable "release refused; blocked_on entry preserved: $TU_MSG"
      require_issue "$id"; cur=$CUR
      relabel "$id" "$cur" "" "seed:bo:$entry"
      envelope ",\"task\":$(jstr "$id"),\"state\":\"ready\""
    else
      relabel "$id" "$cur" "" "seed:bo:$entry"
      envelope ",\"task\":$(jstr "$id"),\"state\":\"blocked\""
    fi
    ;;

  accept|close)
    require_issue "$id"; cur=$CUR
    [ "$(istate "$cur")" = "In Review" ] || fail 3 invalid_transition "close is accept+cascade: review → done only (issue is '$(istate "$cur")')"
    state_id done; update_issue "$id" "{\"stateId\": \"$SID\"}"
    [ -n "$resolution" ] && comment_on "$id" "seed:resolution: $resolution"
    cascade "$id"
    envelope ",\"task\":$(jstr "$id"),\"state\":\"done\",\"cascaded\":$cascaded,\"cascade_skipped\":$cascade_skipped"
    ;;

  reject)
    require_issue "$id"; cur=$CUR
    [ "$(istate "$cur")" = "In Review" ] || fail 3 invalid_transition "reject requires review"
    author=$(printf '%s\n' "$(ilabels "$cur")" | sed -n 's/^seed:author://p' | head -1)
    # State move first: a refused In Review → Todo must leave the author
    # label intact so a retry still knows whom to lock out.
    state_id ready; update_issue "$id" "{\"stateId\": \"$SID\"}"
    adds=""
    [ -n "$author" ] && adds="seed:rejected:$author"
    require_issue "$id"; cur=$CUR
    relabel "$id" "$cur" "$adds" "seed:author:"
    [ -n "$resolution" ] && comment_on "$id" "seed:rejection: $resolution"
    envelope ",\"task\":$(jstr "$id"),\"state\":\"ready\""
    ;;

  cancel)
    require_issue "$id"; cur=$CUR
    case "$(istate "$cur")" in Done|Canceled) fail 3 invalid_transition "already terminal" ;; esac
    # State move first: a refused terminal move must leave a live claim
    # usable. The in_progress → cancelled edge still carries the
    # claim-ending side effect after the move succeeds: a reinstated card
    # must be claimable, not stranded behind a dead holder.
    state_id cancelled; update_issue "$id" "{\"stateId\": \"$SID\"}"
    require_issue "$id"; cur=$CUR
    if [ -n "$(iassignee "$cur")" ]; then
      release_claim "$id" "$cur"
    fi
    cascade "$id"
    envelope ",\"task\":$(jstr "$id"),\"state\":\"cancelled\",\"cascaded\":$cascaded,\"cascade_skipped\":$cascade_skipped"
    ;;

  reinstate)
    require_issue "$id"; cur=$CUR
    [ "$(istate "$cur")" = "Canceled" ] || fail 3 invalid_transition "reinstate requires cancelled"
    state_id backlog; update_issue "$id" "{\"stateId\": \"$SID\"}"
    envelope ",\"task\":$(jstr "$id"),\"state\":\"backlog\""
    ;;

  comment)
    # Fenced only while a live claim exists: the port permits unfenced
    # comments on unclaimed cards (backlog/ready/blocked/review).
    require_issue "$id"
    if [ -n "$(iassignee "$CUR")" ] || [ "$(istate "$CUR")" = "In Progress" ]; then
      require_fence "$id"
    fi
    comment_on "$id" "[$actor] $body"
    envelope ",\"task\":$(jstr "$id"),\"comment_id\":$(jstr "$CID")"
    ;;

  attach-evidence)
    require_issue "$id"; cur=$CUR
    if [ -n "$(iassignee "$cur")" ] || [ "$(istate "$cur")" = "In Progress" ]; then
      require_fence "$id"
    fi
    comment_on "$id" "seed:evidence ($kind): $ref"
    envelope ",\"task\":$(jstr "$id"),\"evidence_id\":$(jstr "$CID")"
    ;;

  lease-renew)
    require_fence "$id"
    envelope ",\"task\":$(jstr "$id"),\"note\":\"no lease concept in Linear (declared variance); fence validated\""
    ;;

  event-append)
    # The event JSON may carry its own task reference; honor it before
    # falling back to the taskless audit sink.
    [ -z "$id" ] && id=$(printf '%s' "$event" | jq -r '.task // ""' 2>/dev/null || echo "")
    if [ -n "$id" ]; then
      comment_on "$id" "seed:event: $event"
    else
      load_issues
      audit=$(printf '%s' "$ISSUES_JSON" | jq -r '.[] | select([.labels.nodes[].name] | index("seed:audit")) | .id' | head -1)
      if [ -z "$audit" ]; then
        state_id backlog; sid=$SID
        alid=$(label_id "seed:audit")
        out=$(gql IssueCreate 'mutation IssueCreate($input: IssueCreateInput!) { issueCreate(input: $input) { success issue { id identifier } } }' \
          "$(jq -nc --arg s "$sid" --arg team "$LINEAR_TEAM_ID" --arg l "$alid" '{input:{title:"seed: audit log", description:"taskless seed events land here", stateId:$s, teamId:$team, priority:4, labelIds:[$l]}}')")
        [ -z "$(gqlerr)" ] || fail 5 backend_unavailable "audit issue create: $(gqlerr)"
        audit=$(printf '%s' "$out" | jq -r '.data.issueCreate.issue.id')
      fi
      comment_on "$audit" "seed:event: $event"
    fi
    envelope ""
    ;;

  *) fail 64 usage "unknown verb '$verb'" ;;
esac
